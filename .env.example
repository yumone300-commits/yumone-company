# Canonical production origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://yumone-company.vercel.app
# Leave empty until the actual GA4 web stream measurement ID is supplied.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Set true only after disabling Enhanced Measurement automatic pageviews, form and search events.
NEXT_PUBLIC_GA4_MANUAL_TRACKING_READY=false

# Support CMS: server-only; connect the existing Notion integration to this database.
NOTION_TOKEN=
NOTION_SUPPORT_DATA_SOURCE_ID=77cacbeb-74fe-4dee-a4e5-206c2f7c9b5e
# Minimum 24 random characters; HTTP Basic username: editor
SUPPORT_ADMIN_PASSWORD=
